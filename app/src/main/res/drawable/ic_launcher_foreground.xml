<?xml version="1.0" encoding="utf-8"?>
<!--
  "Swipe and survive": a swipe clears the row and one coral stick is left standing.
  Drawn in the 190-unit design space of the logo, scaled (0.34) and centred into the 66dp safe zone.
  Vector drawables cannot dash strokes, so the cleared sticks are faint filled outlines.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.34"
        android:scaleY="0.34"
        android:translateX="24"
        android:translateY="21">
        <group
            android:pivotX="95"
            android:pivotY="95"
            android:rotation="-14">
            <!-- Danger glow -->
            <path
                android:fillColor="#2EFF7B6B"
                android:pathData="M111,98 a46,46 0 1 0 92,0 a46,46 0 1 0 -92,0z" />

            <!-- Cleared sticks (ghosts) -->
            <path
                android:fillAlpha="0.14"
                android:fillColor="#F2B84B"
                android:pathData="M20,59 a7,7 0 0 1 14,0 L34,131 a7,7 0 0 1 -14,0z M48,59 a7,7 0 0 1 14,0 L62,131 a7,7 0 0 1 -14,0z M76,59 a7,7 0 0 1 14,0 L90,131 a7,7 0 0 1 -14,0z M104,59 a7,7 0 0 1 14,0 L118,131 a7,7 0 0 1 -14,0z"
                android:strokeAlpha="0.55"
                android:strokeColor="#F2B84B"
                android:strokeWidth="3" />

            <!-- The survivor -->
            <path
                android:fillColor="#FF7B6B"
                android:pathData="M148,55 a9,9 0 0 1 18,0 L166,137 a9,9 0 0 1 -18,0z" />
            <path
                android:fillAlpha="0.55"
                android:fillColor="#FFFFFF"
                android:pathData="M152,62 a2,2 0 0 1 4,0 L156,114 a2,2 0 0 1 -4,0z" />

            <!-- Swipe trail and fingertip -->
            <path
                android:fillColor="#00000000"
                android:pathData="M10,148 L128,70"
                android:strokeColor="#FF5EEAD4"
                android:strokeLineCap="round"
                android:strokeWidth="8" />
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M122.5,66 a10.5,10.5 0 1 0 21,0 a10.5,10.5 0 1 0 -21,0z"
                android:strokeColor="#FF5EEAD4"
                android:strokeWidth="3.5" />
        </group>
    </group>
</vector>
